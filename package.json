{
  "name": "backchat",
  "version": "0.0.3",
  "private": true,
  "description": "Multi-agent desktop client for ACP harnesses",
  "author": "backchat contributors",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "website:dev": "vite --config website.vite.config.ts",
    "website:brand": "node scripts/sync-website-brand-assets.mjs",
    "website:build": "pnpm website:brand && tsc -p tsconfig.website.json --noEmit && vite build --config website.vite.config.ts && node scripts/prerender-website.mjs",
    "website:preview": "vite preview --config website.vite.config.ts",
    "website:deploy": "pnpm website:build && wrangler deploy",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:composer": "electron-vite build && playwright test e2e/composer.spec.ts e2e/composer-slash.spec.ts e2e/composer-config.spec.ts",
    "test:e2e:harness-feature-matrix": "electron-vite build && playwright test e2e/harness-feature-matrix.visual.spec.ts e2e/harness-final-response.real.spec.ts && pnpm run report:harness-feature-matrix",
    "report:harness-feature-matrix": "node scripts/publish-harness-feature-matrix-report.mjs artifacts/harness-feature-matrix-staging artifacts/harness-feature-matrix",
    "test:e2e:fast": "electron-vite build && playwright test e2e/smoke.spec.ts e2e/composer.spec.ts e2e/composer-slash.spec.ts e2e/composer-config.spec.ts e2e/storage.spec.ts e2e/file-first-export.spec.ts",
    "test:e2e:real:codex-plugin": "electron-vite build && OPENMA_REAL_CODEX_PLUGIN_E2E=1 playwright test e2e/codex-plugin.real.spec.ts",
    "test:e2e:real:harness-tools": "electron-vite build && OPENMA_REAL_CODEX_PLUGIN_E2E=1 OPENMA_REAL_PI_COMPUTER_USE_E2E=1 playwright test e2e/codex-plugin.real.spec.ts e2e/pi-computer-use.real.spec.ts",
    "test:e2e:real:pi-computer-use": "electron-vite build && OPENMA_REAL_PI_COMPUTER_USE_E2E=1 playwright test e2e/pi-computer-use.real.spec.ts",
    "smoke:claude-acp-fork": "tsx scripts/smoke-claude-agent-acp-fork.ts",
    "smoke:claude-acp-meta": "tsx scripts/smoke-claude-agent-acp-meta.ts",
    "smoke:codex-acp-native": "tsx scripts/smoke-codex-acp-native.ts",
    "test:e2e": "electron-vite build && playwright test",
    "test:verify": "pnpm run typecheck && pnpm run test && pnpm run test:e2e:fast",
    "package": "electron-vite build && electron-builder",
    "package:browser-extension": "tsx scripts/package-browser-extension.ts",
    "package:dir": "electron-vite build && electron-builder --dir",
    "rebuild": "electron-rebuild -f -w better-sqlite3,node-pty"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@lobehub/icons": "^5.10.0",
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@open-managed-agents-desktop/acp": "workspace:*",
    "@open-managed-agents-desktop/acp-agent-setup": "workspace:*",
    "@openma/common": "github:openma-ai/openma-common#v0.4.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "ai": "^6.0.194",
    "cron-parser": "^5.6.2",
    "liquid-glass-react": "^1.1.1",
    "lucide": "1.17.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "node-pty": "1.2.0-beta.13",
    "radix-ui": "^1.4.3",
    "rrule": "^2.8.1",
    "simple-icons": "^16.22.0",
    "smol-toml": "^1.6.1",
    "streamdown": "^2.5.0",
    "streaming-markdown": "^0.2.15",
    "use-stick-to-bottom": "^1.1.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.64.2",
    "@agentclientprotocol/codex-acp": "1.1.14",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^42.3.1",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "sharp": "0.35.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.123.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "dev.openma.backchat",
    "productName": "Backchat",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
