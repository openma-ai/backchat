{
  "name": "backchat",
  "version": "0.0.17",
  "private": true,
  "description": "Multi-agent desktop client for ACP harnesses",
  "author": "backchat contributors",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "website:dev": "vite --config website.vite.config.ts",
    "website:brand": "node scripts/sync-website-brand-assets.mjs",
    "website:build": "pnpm website:brand && tsc -p tsconfig.website.json --noEmit && vite build --config website.vite.config.ts && node scripts/prerender-website.mjs",
    "website:preview": "vite preview --config website.vite.config.ts",
    "website:deploy": "pnpm website:build && wrangler deploy",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --config vitest.ci.config.ts --reporter=dot",
    "test:watch": "vitest",
    "test:e2e:composer": "electron-vite build && playwright test e2e/composer.spec.ts e2e/composer-slash.spec.ts e2e/composer-config.spec.ts",
    "test:e2e:harness-feature-matrix": "electron-vite build && playwright test e2e/harness-feature-matrix.visual.spec.ts e2e/harness-final-response.real.spec.ts && pnpm run report:harness-feature-matrix",
    "report:harness-feature-matrix": "node scripts/publish-harness-feature-matrix-report.mjs artifacts/harness-feature-matrix-staging artifacts/harness-feature-matrix",
    "test:e2e:fast": "electron-vite build && playwright test e2e/smoke.spec.ts e2e/composer.spec.ts e2e/composer-slash.spec.ts e2e/composer-config.spec.ts e2e/storage.spec.ts e2e/file-first-export.spec.ts e2e/sidebar-custom-sections.spec.ts e2e/project-conversation.spec.ts e2e/coordinator-optimistic-echo.spec.ts e2e/shell-permission-presentation.spec.ts e2e/message-fork.spec.ts e2e/gui-bugfix-batch.spec.ts e2e/chat-reasoning-trigger-appearance.spec.ts",
    "test:e2e:real:codex-plugin": "electron-vite build && OPENMA_REAL_CODEX_PLUGIN_E2E=1 playwright test e2e/codex-plugin.real.spec.ts",
    "test:e2e:real:harness-tools": "electron-vite build && OPENMA_REAL_CODEX_PLUGIN_E2E=1 OPENMA_REAL_PI_COMPUTER_USE_E2E=1 playwright test e2e/codex-plugin.real.spec.ts e2e/pi-computer-use.real.spec.ts",
    "test:e2e:real:pi-computer-use": "electron-vite build && OPENMA_REAL_PI_COMPUTER_USE_E2E=1 playwright test e2e/pi-computer-use.real.spec.ts",
    "test:e2e:real:pi-coordinator": "electron-vite build && OPENMA_REAL_PI_COORDINATOR_E2E=1 playwright test e2e/project-coordinator-pi.real.spec.ts",
    "smoke:claude-acp-fork": "tsx scripts/smoke-claude-agent-acp-fork.ts",
    "smoke:claude-acp-meta": "tsx scripts/smoke-claude-agent-acp-meta.ts",
    "smoke:codex-acp-native": "tsx scripts/smoke-codex-acp-native.ts",
    "smoke:pi-acp-steering": "tsx scripts/smoke-pi-acp-steering.ts",
    "test:e2e": "electron-vite build && playwright test",
    "test:verify": "pnpm run typecheck && pnpm run test && pnpm run test:e2e:fast",
    "runtime:prepare": "node scripts/prepare-bundled-npm-runtime.mjs",
    "package": "electron-vite build && pnpm run runtime:prepare && node scripts/run-mac-builder.mjs",
    "package:browser-extension": "tsx scripts/package-browser-extension.ts",
    "package:dir": "electron-vite build && pnpm run runtime:prepare && node scripts/run-mac-builder.mjs --dir",
    "rebuild": "electron-rebuild -f -w better-sqlite3,node-pty",
    "test:e2e:openma": "electron-vite build && playwright test e2e/openma-account.spec.ts e2e/openma-cloud.spec.ts e2e/openma-daemon-ownership.spec.ts e2e/openma-tenants.spec.ts e2e/direct-agents.spec.ts e2e/power-management.spec.ts e2e/quit-confirmation.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@hono/node-server": "1.19.15",
    "@lobehub/icons": "^5.10.0",
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@open-managed-agents-desktop/acp": "workspace:*",
    "@open-managed-agents-desktop/acp-agent-setup": "workspace:*",
    "@openma/common": "github:openma-ai/openma-common#v0.7.9",
    "@openma/sdk": "workspace:*",
    "@openmatter/agent": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/agent",
    "@openmatter/agent-claude": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/agent-claude",
    "@openmatter/core": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/core",
    "@openmatter/inbox": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/inbox",
    "@openmatter/inbox-sqlite": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/inbox-sqlite",
    "@openmatter/integration": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/integration",
    "@openmatter/orchestration": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/orchestration",
    "@openmatter/project": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/project",
    "@openmatter/project-host": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/project-host",
    "@openmatter/project-mcp": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/project-mcp",
    "@openmatter/runtime": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/runtime",
    "@openmatter/store": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/store",
    "@openmatter/store-sqlite": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/store-sqlite",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tabler/icons-react": "^3.47.0",
    "ai": "^6.0.194",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cors": "2.8.6",
    "cron-parser": "^5.6.2",
    "cross-spawn": "7.0.6",
    "effect": "^3.22.1",
    "electron-updater": "6.8.10",
    "eventsource": "3.0.7",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "liquid-glass-react": "^1.1.1",
    "lucide": "1.17.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.16",
    "node-pty": "1.2.0-beta.13",
    "openai": "7.15.0",
    "radix-ui": "^1.4.3",
    "raw-body": "3.0.2",
    "rrule": "^2.8.1",
    "simple-icons": "^16.22.0",
    "smol-toml": "^1.9.0",
    "streamdown": "^2.5.0",
    "streaming-markdown": "^0.2.15",
    "use-stick-to-bottom": "^1.1.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.64.2",
    "@agentclientprotocol/codex-acp": "1.1.14",
    "@electron/asar": "3.4.1",
    "@openmatter/agent-mock": "github:openma-ai/OpenMatter#620a0d02ace288ddfcdab4283989db3967190bc9&path:/packages/agent-mock",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^42.5.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "happy-dom": "20.0.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-markdown": "^10.1.0",
    "sharp": "0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0",
    "zod": "^4.4.3"
  },
  "build": {
    "beforePack": "./scripts/prepare-packaged-dependencies.mjs",
    "afterPack": "./scripts/verify-packaged-dependencies.mjs",
    "appId": "dev.openma.backchat",
    "productName": "Backchat",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "out/**/*",
      {
        "from": "build/packaged-dependencies/node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "build/bundled-npm-runtime.asar",
        "to": "bundled-npm-runtime.asar"
      },
      {
        "from": "src/cli",
        "to": "cli",
        "filter": [
          "**/*.mjs"
        ]
      },
      {
        "from": "build/update-metadata.json",
        "to": "update-metadata.json"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "files": [
        "out/**/*",
        "!**/*noto-sans*.woff2",
        {
          "from": "build/packaged-dependencies/node_modules",
          "to": "node_modules",
          "filter": [
            "**/*"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "files": [
        "out/**/*",
        "!**/*noto-sans*.woff2",
        {
          "from": "build/packaged-dependencies/node_modules",
          "to": "node_modules",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "openma-ai",
      "repo": "backchat"
    }
  },
  "packageManager": "pnpm@11.24.0"
}
